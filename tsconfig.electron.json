{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-electron",
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["electron/**/*", "shared/**/*"]
}
